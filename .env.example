# Server-side AI keys (Vercel → Project → Settings → Environment Variables).
# All optional. Without keys the site still works: the browser falls back to
# Pollinations (free, no key, ~1 request / 15 s per visitor).

# Groq — fastest. Free tier: 30 req/min, 1,000 req/day per model.
# Create at https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini — backup. Free tier via https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# NEXT_PUBLIC_SITE_URL=https://ai-prompt-builder.vercel.app
